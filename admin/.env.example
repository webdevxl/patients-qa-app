# CareBrain Admin (observability log viewer) — copy to .env.local before running.

# Base URL of the Nest backend that serves GET /qa/logs and POST /auth/session.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Primitive admin gate.
# ⚠️ NEXT_PUBLIC_* values are inlined into the browser bundle, so these are NOT secret —
# this is a convenience gate, not real authentication. A real deployment would gate
# /qa/logs behind a server-side admin role (see ../SECURITY.md).
NEXT_PUBLIC_ADMIN_USER=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin
