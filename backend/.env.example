# Copy to .env before running the backend.
DATABASE_URL=

# LLM provider key — only needed once the LangChain agent is implemented (later step).
# OPENAI_API_KEY=

# LangSmith tracing — when LANGSMITH_TRACING=true, every LangChain agent run is
# automatically traced to LangSmith (no code changes needed). Get a key at
# https://smith.langchain.com → Settings. LANGSMITH_PROJECT groups the traces.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=patients-qa
