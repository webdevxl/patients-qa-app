// Prisma schema for the Patient Q&A sandbox.
// Models map 1:1 to the provided CSV tables. Field names are camelCase and
// mapped to the original snake_case columns via @map / @@map.
//
// Cohort isolation: only `Patient` carries the `group` column (A/B). Child
// records inherit cohort through `patientId` -> Patient.group. `group` and the
// `patientId` foreign keys are indexed so cohort-scoped lookups stay cheap.

generator client {
  provider        = "prisma-client-js"
  // postgresqlExtensions lets the schema declare the pgvector extension below, so
  // `prisma migrate` emits `CREATE EXTENSION IF NOT EXISTS "vector"` for us.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Patient {
  id                   String    @id
  nameFirst            String?   @map("name_first")
  nameLast             String?   @map("name_last")
  dob                  DateTime? @db.Date
  gender               String?
  ethnicityDescription String?   @map("ethnicity_description")
  legalMailingAddress  Json?     @map("legal_mailing_address")
  unitDescription      String?   @map("unit_description")
  floorDescription     String?   @map("floor_description")
  roomDescription      String?   @map("room_description")
  bedDescription       String?   @map("bed_description")
  status               String?
  admissionTime        DateTime? @map("admission_time") @db.Timestamptz
  dischargeTime        DateTime? @map("discharge_time") @db.Timestamptz
  deathTime            DateTime? @map("death_time") @db.Timestamptz
  email                String?
  phone                String?
  outpatient           Boolean?
  revBy                String?   @map("rev_by")
  revTime              DateTime? @map("rev_time") @db.Timestamptz
  onLeave              Boolean?  @map("on_leave")
  group                String

  allergies    PatientAllergy[]
  conditions   PatientCondition[]
  medications  PatientMedication[]
  observations PatientObservation[]

  @@index([group])
  @@map("patient")
}

model PatientAllergy {
  id              String    @id
  patientId       String    @map("patient_id")
  allergen        String?
  category        String?
  clinicalStatus  String?   @map("clinical_status")
  createdBy       String?   @map("created_by")
  createdTime     DateTime? @map("created_time") @db.Timestamptz
  onsetDate       DateTime? @map("onset_date") @db.Date
  reactionNote    String?   @map("reaction_note")
  reactionType    String?   @map("reaction_type")
  reactionSubType String?   @map("reaction_sub_type")
  resolvedDate    DateTime? @map("resolved_date") @db.Date
  revBy           String?   @map("rev_by")
  revTime         DateTime? @map("rev_time") @db.Timestamptz
  severity        String?
  type            String?
  allergenId      String?   @map("allergen_id") // FK to the canonical allergen dictionary

  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  canonicalAllergen Allergen? @relation(fields: [allergenId], references: [id])

  @@index([patientId])
  @@index([allergenId])
  @@map("patient_allergy")
}

// Canonical allergen vocabulary. One row per real-world allergen; the many noisy raw
// `patient_allergy.allergen` strings (case/plural variants, synonyms, free-text noise)
// collapse onto a single row via the deterministic normalizer in
// src/allergens/allergen-normalize.ts. Each patient_allergy row points here via
// `allergen_id`. Like `icd_code`, this is a shared vocabulary table; cohort scoping happens
// on the patient join, not here.
model Allergen {
  id            String                       @id // deterministic slug, e.g. "penicillin", "sulfa-antibiotics"
  canonicalName String                       @unique @map("canonical_name") // display name, e.g. "Penicillin"
  category      String? // Drug | Food | Other (curated; falls back to the CSV category)
  // Semantic embedding of `canonicalName` (pgvector). Like icd_code.embedding: Prisma can't
  // model pgvector natively, so it's declared Unsupported + nullable and read/written only via
  // raw SQL by the embed-allergen-* scripts. Nullable so the vocab row exists before its vector
  // is backfilled. 1536 dims matches OpenAI `text-embedding-3-small` (src/embeddings/embeddings.factory.ts).
  embedding     Unsupported("vector(1536)")?
  createdTime   DateTime                     @default(now()) @map("created_time") @db.Timestamptz

  allergies PatientAllergy[]

  @@map("allergen")
}

model PatientCondition {
  id                 String    @id
  patientId          String    @map("patient_id")
  clinicalStatus     String?   @map("clinical_status")
  createdBy          String?   @map("created_by")
  createdTime        DateTime? @map("created_time") @db.Timestamptz
  icd10Code          String?   @map("icd_10_code")
  icd10Description   String?   @map("icd_10_description")
  onsetDate          DateTime? @map("onset_date") @db.Date
  isPrimaryDiagnosis Boolean?  @map("is_primary_diagnosis")
  resolvedDate       DateTime? @map("resolved_date") @db.Date
  revBy              String?   @map("rev_by")
  revTime            DateTime? @map("rev_time") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  // Covering index for Stage-2 of the attribute search (find-patients.tool.ts): resolve
  // `icd_10_code = ANY(resolved codes)` and read `patient_id` for the patient join from the index
  // alone. Mirrors patient_allergy(allergen_id), which already serves the allergy path.
  @@index([icd10Code, patientId])
  @@map("patient_condition")
}

model PatientMedication {
  id           String    @id
  patientId    String    @map("patient_id")
  createdTime  DateTime? @map("created_time") @db.Timestamptz
  description  String?
  directions   String?
  genericName  String?   @map("generic_name")
  narcotic     Boolean?
  orderTime    DateTime? @map("order_time") @db.Timestamptz
  revTime      DateTime? @map("rev_time") @db.Timestamptz
  rxNormId     String?   @map("rx_norm_id")
  startTime    DateTime? @map("start_time") @db.Date
  status       String?
  strength     String?
  strengthUnit String?   @map("strength_unit")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_medication")
}

model PatientObservation {
  id           String    @id
  patientId    String    @map("patient_id")
  method       String?
  recordedBy   String?   @map("recorded_by")
  recordedTime DateTime? @map("recorded_time") @db.Timestamptz
  data         Json?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_observation")
}

// Distinct ICD-10 vocabulary with a semantic embedding of the description. Powers
// `find_patients_by_condition`: a free-text condition is embedded and matched against these
// rows by cosine similarity (`embedding <=> $query`), then joined to patient_condition ->
// patient. Cohort-agnostic by design — codes are a shared vocabulary; only the patient join
// is (eventually) cohort-scoped.
//
// `embedding` is a pgvector column Prisma can't model natively, so it's declared `Unsupported`
// and read/written exclusively via raw SQL ($queryRaw / $executeRaw). It is nullable so the
// row (code + description) can be upserted before its vector is backfilled. 1536 dims matches
// OpenAI `text-embedding-3-small` (see src/embeddings/embeddings.factory.ts).
model IcdCode {
  code        String                       @id
  description String
  embedding   Unsupported("vector(1536)")?
  createdTime DateTime                     @default(now()) @map("created_time") @db.Timestamptz

  @@map("icd_code")
}

// Per-request audit log. Exactly one row per /qa/query request, written by RequestLogService
// (best-effort; never blocks the response). This is the auditable, queryable store the eval reads
// ("was the cross-group attempt BLOCKED, LOGGED, and answered SAFELY?"). Cohort-AGNOSTIC table:
// `group` is a recorded attribute, not a scoping key — rows span BOTH cohorts by design. It is the
// system-of-record for the audit trail; LangSmith (when LANGSMITH_TRACING is on) is the complementary
// deep-trace layer, with each agent's run tagged `agent:<name>` so the two agents are filterable there.
model RequestLog {
  id                String   @id @default(uuid())
  traceId           String   @unique @map("trace_id") // matches QaResult.traceId + the server log lines
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ── Request context ──
  group             String // active cohort 'A' | 'B'
  agent             String? // which agent ran: 'find-patient' | 'answer-patient' | null (no model call)
  question          String // bounded upstream (MAX_QUESTION_CHARS)
  history           Json? // sanitized prior turns (ChatTurn[])
  resolvedPatientId String? @map("resolved_patient_id") // patient identified/answered-about, if any
  retrievalPath     String  @map("retrieval_path") // 'identity' | 'attribute' | 'none'

  // ── Retrieval + model I/O ──
  recordsRetrieved Json? @map("records_retrieved") // [{ table, id }] source-table provenance refs
  rawModelOutput   Json? @map("raw_model_output") // raw text / tool-call args the model emitted

  // ── Structured response ──
  answer     String? // grounded prose (answer path only)
  confidence String? // 'High' | 'Medium' | 'Low' | null
  citations  Json? // string[] of source-record labels

  // ── Outcome + security flags (the eval's queryable columns) ──
  outcome           String // answered | patients_found | no_match | cohort_violation | injection_refused | not_answerable | error
  fallbackUsed      Boolean @map("fallback_used") // true whenever SAFE_FALLBACK was returned ("safe response")
  injectionDetected Boolean @map("injection_detected")
  cohortViolation   Boolean @map("cohort_violation") // the high-severity cross-group event
  severity          String // 'none' | 'low' | 'medium' | 'high'

  // ── Metrics ──
  inputTokens  Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")
  totalTokens  Int? @map("total_tokens")
  durationMs   Int  @map("duration_ms")

  @@index([group])
  @@index([agent])
  @@index([createdAt])
  @@index([resolvedPatientId])
  @@index([outcome])
  @@index([cohortViolation])
  @@map("request_log")
}
