# Copy to `.env` at the repo root before running anything. All three apps
# (backend, admin, db-dump tools) load this single file via
# `node --env-file=../.env …` baked into their npm scripts. Do not create
# per-app .env files anymore — they're not loaded.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection used by Prisma + seed/embed scripts + db-dump install.
# Matches the credentials in docker-compose.yml; change for hosted deployments.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/patients_qa?schema=public"

# ── Backend / LLM ───────────────────────────────────────────────────────────
# OpenAI key for the find/answer agents and embedding compute scripts.
OPENAI_API_KEY=

# Injection-guard classifier (opt-in). When set, every Q&A request first runs through
# a small OpenAI model that flags prompt-injection (system_prompt_override) and
# cross-cohort access attempts before reaching the bigger find/answer model.
# Unset ⇒ guard is a no-op (zero tokens, zero latency); behavior matches pre-guard
# baseline. Guard verdict is recorded on every `request_log` row regardless.
# OPENAI_GUARD_MODEL=gpt-5-nano
# OPENAI_GUARD_TEMPERATURE=0

# LangSmith tracing — when LANGSMITH_TRACING=true every LangChain agent run is
# automatically traced. Get a key at https://smith.langchain.com → Settings.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=patients-qa

# ── Auth ────────────────────────────────────────────────────────────────────
# Cohort session-token signing key (build-out plan #1). REQUIRED — backend
# refuses to start without it. Use a long random string, e.g.
# `openssl rand -hex 32`.
JWT_SECRET=
# Optional token lifetime (any jsonwebtoken duration string). Defaults to 12h.
# JWT_EXPIRES_IN=12h

# Admin API key for the security eval verification endpoints.
# ADMIN_API_KEY=

# ── Admin SPA (Next.js, build-time inlining) ────────────────────────────────
# Base URL of the Nest backend that serves GET /qa/logs and POST /auth/session.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Primitive admin gate.
# ⚠️ NEXT_PUBLIC_* values are inlined into the browser bundle, so these are NOT
# secret — this is a convenience gate, not real authentication. A real deployment
# would gate /qa/logs behind a server-side admin role (see SECURITY.md).
NEXT_PUBLIC_ADMIN_USER=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin
